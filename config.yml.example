# Model provider configuration
providers:
  openai:
    type: openai
    base_url: https://api.openai.com/v1
    api_key: sk-xxxxx

# Model configuration
models:
  gpt4:
    provider: openai
    model: gpt-4
    max_tokens: 4096
    temperature: 0.7

# MCP server configuration
mcp_servers:
  # SSE type MCP server
  sse_server:
    type: mcp
    config:
      url: "http://localhost:3000/mcp"  # MCP server URL
      headers:
        "Content-Type": "application/json"
        "Authorization": "Bearer your-token"  # Optional authentication header

  # STDIO type MCP server
  stdio_server:
    type: stdio
    config:
      cmd: "python"                    # Command to execute
      args:
        - "-m"
        - "your_mcp_server"             # MCP server module
      env:
        "PYTHONPATH": "/path/to/server" # Environment variable
        "API_KEY": "your-api-key"

# Agent configuration
agents:
  search_agent:
    system: "You are a search assistant that can help users search for information"
    model: gpt4
    tools:
      - duckduckgo_search
      - wikipedia_search
    mcp_servers:                        # MCP servers that can be used by the Agent
      - sse_server

  # Multi-function assistant example (including custom tools and MCP servers)
  multi_agent:
    system: "You are a multi-function assistant that can search for information, query weather, get system information, etc."
    model: gpt4
    tools:
      - duckduckgo_search
      - weather_api
      - system_info
    mcp_servers:
      - sse_server
      - stdio_server

# Tool configuration
tools:
  # Skill presets can be switched at runtime in the TUI: /skill <name>
  duckduckgo_search:
    type: duckduckgo
    config:
      max_results: 10        # Maximum number of search results, default 10
      region: "wt"           # Search region: wt(worldwide), cn(China), us(USA), uk(UK)
      safe_search: "off"     # Safe search: off(off), moderate(moderate), strict(strict)
      timeout: 10            # Timeout in seconds, default 10 seconds

  # Custom HTTP tool example
  weather_api:
    type: customhttp
    description: "API tool for getting weather information"
    config:
      url: "https://api.openweathermap.org/data/2.5/weather?q={{city}}"
      method: "GET"
      headers:
        "Content-Type": "application/json"
    params:
      - name: "city"
        type: "string"
        description: "City name"
        required: true

  # Custom command line tool example
  system_info:
    type: customexec
    description: "Get system information"
    config:
      cmd: "uname -a && df -h"
      dir: "/tmp"
      timeout: 30
    params: []

  # Filesystem tool: read/write/list/move/grep files below a root directory.
  # Paths outside the root (including through symlinks) are rejected.
  workspace:
    type: filesystem
    config:
      root: "."              # Directory the tool may access, default: current dir
      max_bytes: 204800      # Read budget per call in bytes, default 200 KiB
      max_entries: 500       # Max entries returned by list, default 500
      timeout: 30            # Per-call timeout in seconds, default 30

  # Subagent tool: delegate a self-contained task to another agent, either a
  # configured one or one created on the fly from a system prompt.
  subagent:
    type: subagent
    config:
      agents: []           # allowlist of configured agents, empty = all
      tools: []            # allowlist for temporary agents, empty = all
      # children inherit the parent's current model unless it is pinned
      allow_temp: true     # allow ad-hoc agents built from a system prompt
      max_depth: 1         # subagent nesting limit
      timeout: 300         # per-child-run timeout in seconds

  # Browser automation (browser-use backend required). The browser starts on
  # the first tool call, not when the app starts.
  browseruse:
    type: browseruse
    # config:
    #   headless: true        # run without a visible window (default: false)
    #   chrome_path: ""       # custom Chrome/Chromium executable
    #   proxy: ""             # optional proxy server
    #   args: []              # extra Chromium flags

  # Interactive tools. Agent sessions add these automatically (the TUI hosts
  # them); declare them explicitly to use them in `run`.
  ask_user:
    type: askuser
  todolist:
    type: todolist

# Skills: switchable capability presets (TUI: /skill <name>)
skills:
  translator:
    description: "Translation assistant (EN <-> ZH)"
    system: "You are a professional translator. Translate Chinese to English and English to Chinese, output only the translation."
  coder:
    description: "Coding assistant with runnable examples"
    system: "You are a senior engineer. Prefer concise, runnable code examples with brief explanations."

settings:
  # Tool approval (interactive TUI only; run/ACP start without a prompt).
  approval:
    mode: dangerous      # off: never ask | dangerous: ask for mutating calls (default) | all: ask every call
    allow: []            # tool names that never need confirmation
    always: []           # tool names that always do (e.g. MCP tools, which cannot be classified)

  langfuse:
    host: https://cloud.langfuse.com
    public_key: pk-xxx
    secret_key: sk-xxx
